VITE_API_BASE_URL=/api/v1
VITE_BACKEND_ORIGIN=https://yoyo-ecom-production-88e8.up.railway.app

# DEV ONLY: skip the login screen and enter the dashboard with a mock user.
# Only takes effect under "npm run dev"; ignored in production builds.
VITE_DEV_AUTH_BYPASS=false

# DEV ONLY: serve synthetic API responses so the UI is usable and verifiable
# while the real backend is down. No effect outside "npm run dev".
VITE_MOCK_API=true

# E2E (Playwright) login for tests/e2e. Use a dedicated test account; never commit real values.
E2E_EMAIL=
E2E_PASSWORD=
