VITE_API_BASE_URL=/api/v1
# kull-mart backend. Locally: cd ../kull-mart/backend && python manage.py runserver 8000
VITE_BACKEND_ORIGIN=http://127.0.0.1:8000

# DEV ONLY: skip the login screen and enter the dashboard with a mock user.
# Only takes effect under "npm run dev"; ignored in production builds.
VITE_DEV_AUTH_BYPASS=false

# E2E (Playwright) login for tests/e2e. Use a dedicated test account; never commit real values.
# With a seeded local backend: python manage.py seed_data --admins 1
E2E_EMAIL=
E2E_PASSWORD=
